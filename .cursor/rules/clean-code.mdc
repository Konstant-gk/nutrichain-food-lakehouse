## Functions and modules (Python)

### Small, single-purpose functions

```python
# ❌ Bad — validates, aggregates, writes, and notifies in one block
def process_daily_sales(raw_path: str) -> None:
    rows = read_csv(raw_path)
    if not rows:
        raise ValueError("empty")
    total = sum(float(r["amount"]) for r in rows)
    if total < 0:
        total = 0
    conn.execute("INSERT INTO daily_totals VALUES (?)", (total,))
    send_slack(f"Total {total}")

# ✅ Good — steps are separate and named
def validate_non_empty_rows(rows: list[dict]) -> None:
    if not rows:
        raise ValueError("Input rows must not be empty")

def sum_amounts(rows: list[dict]) -> Decimal:
    return sum(Decimal(str(r["amount"])) for r in rows)

def persist_daily_total(total: Decimal, conn: Connection) -> None:
    conn.execute("INSERT INTO daily_totals (total_amount) VALUES (?)", (str(total),))

def process_daily_sales(raw_path: str, conn: Connection) -> Decimal:
    rows = read_csv(raw_path)
    validate_non_empty_rows(rows)
    total = sum_amounts(rows)
    persist_daily_total(total, conn)
    return total
```

### Early returns (Python)

```python
# ❌ Bad — deep nesting
def tier_discount(years_as_customer: int | None, is_premium: bool) -> float:
    if years_as_customer is not None:
        if is_premium:
            if years_as_customer > 5:
                return 0.30
            else:
                return 0.20
        else:
            return 0.10
    return 0.0

# ✅ Good — guard clauses
def tier_discount(years_as_customer: int | None, is_premium: bool) -> float:
    if years_as_customer is None:
        return 0.0
    if not is_premium:
        return 0.10
    if years_as_customer > 5:
        return 0.30
    return 0.20
```

