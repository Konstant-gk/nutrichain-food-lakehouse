## SOLID (Python in pipelines)

### Single responsibility — separate I/O from pure transforms

```python
# ❌ Bad — file + pandas + DB in one class doing everything
class Pipeline:
    def run(self, path: str) -> None:
        df = pd.read_csv(path)
        df["x"] = df["a"] + df["b"]
        df.to_sql("out", self.engine, if_exists="replace")

# ✅ Good — extract pure transform; I/O stays thin
def add_computed_column(df: pd.DataFrame) -> pd.DataFrame:
    out = df.copy()
    out["line_total"] = out["unit_price"] * out["quantity"]
    return out

def run_pipeline(path: str, engine: Engine) -> None:
    df = pd.read_csv(path)
    df = add_computed_column(df)
    df.to_sql("silver_line_items", engine, if_exists="replace", index=False)
```

### Dependency injection — swap storage or clients in tests

```python
# ❌ Bad — hard-coded client inside business logic
def fetch_records() -> list[dict]:
    return requests.get("https://api.example.com/v1/data", timeout=30).json()

# ✅ Good — inject client or base URL + session
def fetch_records(client: requests.Session, base_url: str) -> list[dict]:
    response = client.get(f"{base_url}/v1/data", timeout=30)
    response.raise_for_status()
    return response.json()
```

