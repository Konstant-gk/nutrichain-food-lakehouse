dbt/profiles.yml
dbt/.user.yml
dbt/logs/
dbt/target/

# Accidental dbt CLI output when run outside dbt/ (wrong working directory)
/logs/

# Virtual environment
venv/
.venv/
env/

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp

# Accidental nested checkout (duplicate repo folder under project root)
/nutrichain-food-lakehouse/
/.venv-dbt
